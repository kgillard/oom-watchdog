<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.trongus.oom</groupId>
    <artifactId>oom-watchdog-parent</artifactId>
    <version>1.7.13.5</version>
  </parent>

  <artifactId>oom-watchdog-core</artifactId>
  <name>OOM Watchdog – Core</name>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Xlint:-path</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Javadoc JAR: oom-watchdog-javadoc.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <executions>
          <execution>
            <id>attach-javadoc</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <finalName>oom-watchdog</finalName>
              <quiet>true</quiet>
              <doclint>all,-missing</doclint>
              <windowtitle>OOM Watchdog ${project.version} API</windowtitle>
              <doctitle>OOM Watchdog ${project.version} API</doctitle>
              <header><![CDATA[<b>OOM Watchdog ${project.version}</b>]]></header>
              <bottom><![CDATA[Copyright &copy; 2025 Kristen Gillard. All rights reserved.]]></bottom>
              <links>
                <link>https://docs.oracle.com/en/java/javase/11/docs/api/</link>
              </links>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Executable fat-jar: oom-watchdog.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>oom-watchdog</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation=
                    "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.trongus.oom.WatchdogMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
