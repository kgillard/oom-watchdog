# ==============================================================================
# OOM Watchdog – Multi-Target Configuration Example (targets.properties)
#
# Declares remote JVM processes to monitor concurrently via standard JMX (JSR-160).
#
# Format:
#   target.<name>.jmx-url       = service:jmx:rmi:///jndi/rmi://<host>:<port>/jmxrmi  (required)
#   target.<name>.warn          = 0.80                                                  (optional, default 0.80)
#   target.<name>.crit          = 0.90                                                  (optional, default 0.90)
#   target.<name>.gc            = 0.50                                                  (optional, default 0.50)
#   target.<name>.poll-ms       = 5000                                                  (optional, default 5000)
#   target.<name>.dump-types    = heap,thread,class_histogram                           (optional, default none)
#   target.<name>.dump-dir      = ./dumps/<name>                                        (optional, default ./dumps/<name>)
#   target.<name>.username      = <jmx-user>                                            (optional)
#   target.<name>.password      = <jmx-password>                                        (optional)
#
# Direct Dump API – option A: target JVM embeds DumpApiServer (preferred for same-host deployments):
#   target.<name>.dump-api-url  = http://localhost:<port>
#
#   When set, the watchdog forwards POST /dump/heap, /dump/thread, /dump/core requests
#   directly to the target JVM's embedded DumpApiServer instead of using JMX RMI.
#   The target JVM calls its own local MXBeans — no JMX port required for dumps.
#   Dumps are written to the DumpApiServer's configured directory inside the target JVM.
#
#   To enable, start DumpApiServer inside the target JVM:
#     DumpApiServer dumpApi = new DumpApiServer(19999, "/var/log/dumps/myapp");
#     dumpApi.start();
#
# Direct Dump API – option B: watchdog auto-starts DumpApiServer (no target code changes required):
#   target.<name>.dump-api-port = <port>
#
#   When set, the watchdog starts its own DumpApiServer on the given port and delegates
#   all dump operations to the target JVM via the existing JMX connection.  The target JVM
#   requires zero code changes.  Mutually exclusive with dump-api-url (url takes precedence).
#   Falls back to JMX if neither dump-api-url nor dump-api-port is set.
#
# Per-metric dump thresholds (all optional, default: disabled = -1):
#   target.<name>.gc-dump-threshold      = 0.40   Trigger dump when GC overhead >= this fraction
#   target.<name>.heap-dump-threshold    = 0.80   Trigger dump when heap ratio >= this (independent
#                                                  of the CRITICAL-level dump)
#   target.<name>.nursery-dump-threshold = 0.90   Trigger dump when nursery/young-gen ratio >=
#                                                  this (computed from MemoryPoolMXBean entries
#                                                  containing "Eden", "Nursery", or "Young")
#
# QRadar LEEF event customisation (optional):
#   target.<name>.leef-category = <string>   Overrides the LEEF 'cat' attribute
#                                             (default: JVM_OOM_Risk)
#   target.<name>.leef-tags     = <string>   Adds a 'tags' attribute to the LEEF event.
#                                             Use comma-separated key=value pairs for
#                                             environment, team, or topology context.
#                                             (default: omitted)
# ==============================================================================

# ------------------------------------------------------------------------------
# IBM QRadar – hostcontext
# ------------------------------------------------------------------------------
# Enable JMX in /opt/qradar/systemd/bin/hostcontext.sh or systemd unit:
#   -Dcom.sun.management.jmxremote
#   -Dcom.sun.management.jmxremote.port=7777
#   -Dcom.sun.management.jmxremote.ssl=false
#   -Dcom.sun.management.jmxremote.authenticate=false
#
# Option A – target JVM embeds DumpApiServer:
#   DumpApiServer dumpApi = new DumpApiServer(19777, "/var/log/qradar/dumps/hostcontext");
#   dumpApi.start();
# Option B – watchdog auto-starts (no target code changes): use dump-api-port instead of dump-api-url
target.hostcontext.jmx-url              = service:jmx:rmi:///jndi/rmi://localhost:7777/jmxrmi
target.hostcontext.warn                 = 0.75
target.hostcontext.crit                 = 0.85
target.hostcontext.gc                   = 0.40
target.hostcontext.poll-ms              = 3000
target.hostcontext.dump-types           = heap,thread
target.hostcontext.dump-dir             = /var/log/qradar/dumps/hostcontext
# target.hostcontext.dump-api-url       = http://localhost:19777    # only if DumpApiServer is embedded in the target JVM
# target.hostcontext.dump-api-port      = 19777    # alternative to dump-api-url (watchdog-hosted)
target.hostcontext.gc-dump-threshold    = 0.40
target.hostcontext.heap-dump-threshold  = 0.80
target.hostcontext.leef-category        = JVM_OOM_QRadar_hostcontext
target.hostcontext.leef-tags            = env=prod,component=hostcontext,team=qradar-ops

# ------------------------------------------------------------------------------
# IBM QRadar / Tomcat Web Server (UI & API)
# ------------------------------------------------------------------------------
# Enable JMX in /opt/tomcat/bin/setenv.sh or /opt/qradar/bin/tomcat.sh:
#   CATALINA_OPTS="$CATALINA_OPTS -Dcom.sun.management.jmxremote.port=8090 ..."
#
# Option A – target JVM embeds DumpApiServer:
#   DumpApiServer dumpApi = new DumpApiServer(19779, "/var/log/qradar/dumps/tomcat");
#   dumpApi.start();
# Option B – watchdog auto-starts (no target code changes): use dump-api-port instead of dump-api-url
target.tomcat.jmx-url                   = service:jmx:rmi:///jndi/rmi://localhost:8090/jmxrmi
target.tomcat.warn                      = 0.80
target.tomcat.crit                      = 0.90
target.tomcat.dump-types                = heap,thread,class_histogram
target.tomcat.dump-dir                  = /var/log/qradar/dumps/tomcat
# target.tomcat.dump-api-url            = http://localhost:19779    # only if DumpApiServer is embedded in the target JVM
# target.tomcat.dump-api-port           = 19779    # alternative to dump-api-url (watchdog-hosted)
target.tomcat.nursery-dump-threshold    = 0.90
target.tomcat.leef-category             = JVM_OOM_QRadar_tomcat
target.tomcat.leef-tags                 = env=prod,component=tomcat,team=qradar-ops

# ------------------------------------------------------------------------------
# IBM WebSphere Application Server (WAS Traditional)
# ------------------------------------------------------------------------------
target.was.jmx-url            = service:jmx:rmi:///jndi/rmi://localhost:8880/jmxrmi
target.was.warn               = 0.80
target.was.crit               = 0.90
target.was.poll-ms            = 5000
target.was.dump-dir           = /var/log/was/dumps
# target.was.dump-api-url     = http://localhost:19880   # option A: uncomment if DumpApiServer is embedded
# target.was.dump-api-port    = 19880                    # option B: watchdog auto-starts (no target changes)

# ------------------------------------------------------------------------------
# IBM WebSphere Liberty / Open Liberty
# ------------------------------------------------------------------------------
# Enable JMX in server.xml:
#   <featureManager><feature>restConnector-2.0</feature></featureManager>
target.liberty.jmx-url        = service:jmx:rmi:///jndi/rmi://localhost:9443/jmxrmi
target.liberty.warn           = 0.75
target.liberty.crit           = 0.88
target.liberty.dump-types     = heap,thread
target.liberty.dump-dir       = /var/log/liberty/dumps
# target.liberty.dump-api-url = http://localhost:19443   # option A: uncomment if DumpApiServer is embedded
# target.liberty.dump-api-port= 19443                    # option B: watchdog auto-starts (no target changes)

# ------------------------------------------------------------------------------
# IBM Cognos – Content Manager (CM) / Admin Task Center (ATC)
# ------------------------------------------------------------------------------
target.cognos-atc.jmx-url     = service:jmx:rmi:///jndi/rmi://localhost:9300/jmxrmi
target.cognos-atc.warn        = 0.80
target.cognos-atc.crit        = 0.90
target.cognos-atc.dump-types  = heap,thread
target.cognos-atc.dump-dir    = /var/log/cognos/dumps
# target.cognos-atc.dump-api-url  = http://localhost:19300   # option A: uncomment if DumpApiServer is embedded
# target.cognos-atc.dump-api-port = 19300                    # option B: watchdog auto-starts (no target changes)
