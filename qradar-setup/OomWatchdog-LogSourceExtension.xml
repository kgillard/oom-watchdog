<ns2:device-extension xmlns:ns2="event_parsing/device_extension">
    <match-group event-name-filter="OOM_WARNING" order="1">
        <event-match-single force-qidmap-lookup-on-fixup="true"
            send-identity="OverrideAndAlwaysSendOnlySpecifiedFields"
            device-event-category="OOM_WARNING"
            event-name="OOM-Watchdog-Warning"/>
    </match-group>
    <match-group event-name-filter="OOM_CRITICAL" order="2">
        <event-match-single force-qidmap-lookup-on-fixup="true"
            send-identity="OverrideAndAlwaysSendOnlySpecifiedFields"
            device-event-category="OOM_CRITICAL"
            event-name="OOM-Watchdog-Critical"/>
    </match-group>
    <match-group event-name-filter="OOM_FIRING" order="3">
        <event-match-single force-qidmap-lookup-on-fixup="true"
            send-identity="OverrideAndAlwaysSendOnlySpecifiedFields"
            device-event-category="OOM_FIRING"
            event-name="OOM-Watchdog-OOM-Firing"/>
    </match-group>
</ns2:device-extension>
